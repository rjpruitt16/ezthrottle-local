#!/bin/sh

if [ -n "$FLY_APP_NAME" ]; then
  export DNS_CLUSTER_QUERY="${FLY_APP_NAME}.internal"
  # Mnesia's on-disk schema is tied to the exact node name. The previous
  # value here embedded FLY_IMAGE_REF (changes every deploy) and
  # FLY_PRIVATE_IP (can change across a machine restart) — either one
  # changing makes Mnesia treat disc_copies data as belonging to a node
  # that no longer exists, breaking durability across restarts/deploys.
  # This app is a single-node ("singleton") service by design and doesn't
  # use Erlang clustering, so a fixed, stable node name is what Mnesia
  # actually needs here.
  export RELEASE_NODE="${FLY_APP_NAME}@localhost"
  # configure node for distributed erlang with IPV6 support
  export ERL_AFLAGS="-proto_dist inet6_tcp"
  export ECTO_IPV6="true"
fi

export RELEASE_DISTRIBUTION="name"

# Uncomment to send crash dumps to stderr
# This can be useful for debugging, but may log sensitive information
# export ERL_CRASH_DUMP=/dev/stderr
# export ERL_CRASH_DUMP_BYTES=4096

# when not running on fly.io, use a sensible default
export RELEASE_NODE=${RELEASE_NODE:-<%= @release.name %>@$(hostname)}
