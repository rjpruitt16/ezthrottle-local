#!/bin/sh

if [ -n "$FLY_APP_NAME" ]; then
  if [ -n "$DNS_CLUSTER_QUERY" ]; then
    # DNSPoll discovers private IPs, so clustered node names must use the
    # same addresses and a common basename.
    export RELEASE_NODE="${RELEASE_NODE:-${FLY_APP_NAME}@${FLY_PRIVATE_IP}}"
  else
    # Preserve the stable singleton identity used by existing Fly volumes.
    # Mnesia's on-disk schema is tied to this exact node name. Short names:
    # long names reject a host without a dot, so with "name" nothing could
    # connect to this node (bin/spillway remote and rpc failed with
    # "Hostname localhost is illegal"). The node name is the same either way.
    export RELEASE_NODE="${RELEASE_NODE:-${FLY_APP_NAME}@localhost}"
    SPILLWAY_DISTRIBUTION="sname"
  fi
  # configure node for distributed erlang with IPV6 support
  export ERL_AFLAGS="-proto_dist inet6_tcp"
  export ECTO_IPV6="true"
fi

export RELEASE_DISTRIBUTION="${SPILLWAY_DISTRIBUTION:-name}"

# Uncomment to send crash dumps to stderr
# This can be useful for debugging, but may log sensitive information
# export ERL_CRASH_DUMP=/dev/stderr
# export ERL_CRASH_DUMP_BYTES=4096

# when not running on fly.io, use a sensible default
export RELEASE_NODE=${RELEASE_NODE:-<%= @release.name %>@$(hostname)}
